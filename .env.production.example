# =====================================================================
# 裝在老師電腦上（校內區網）的設定範本
#
# 用法：複製成 .env，把 JWT_SECRET 換成自己的，其餘通常不必改。
#   copy .env.production.example .env
# =====================================================================

# ---------- 執行模式 ----------
# 這一行讓程式進入正式模式：自動托管前端、關閉開發用的寬鬆設定
NODE_ENV=production

# ---------- 資料庫 ----------
# PGlite 是嵌入式 Postgres，不必另外安裝任何資料庫軟體，
# 整個資料庫就是 apps/api/.data 這個資料夾（要備份的就是它）。
# 學校規模（幾百人、每份作業幾百筆繳交）用這個綽綽有餘。
DB_DRIVER=pglite
PGLITE_DATA_DIR=./.data/pg

# 若之後改用真正的 PostgreSQL：
# DB_DRIVER=pg
# DATABASE_URL=postgres://user:pass@localhost:5432/work_student

# ---------- 檔案儲存 ----------
# 學生上傳的檔案直接存在老師電腦的硬碟：apps/api/.storage
# 這個資料夾同樣要備份。
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./.storage

# ---------- 服務 ----------
PORT=3000

# API_PUBLIC_URL 不要設。
# 留空時系統會簽發「相對路徑」的上傳/下載網址，學生不論從
# http://192.168.1.50:3000 還是 http://localhost:3000 進來都能正常運作。
# 設成固定網址反而會在換 IP 時整個壞掉。
# API_PUBLIC_URL=

# 前端由 API 自己托管（同源），所以這個值在單機部署時用不到，保留預設即可
WEB_ORIGIN=http://localhost:3000

# ---------- 安全 ----------
# ★ 一定要換成自己的，換掉後所有人需要重新登入。產生方式：
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=請換掉這一行

# ★ 校內區網用純 HTTP（http://192.168.x.x:3000）連線時必須為 false。
# 若設成 true，瀏覽器會靜默丟棄登入 cookie —— 症狀是「登入好像成功了，
# 但一進到下一頁又變回未登入」，這是最容易卡住的地方。
# 只有當你之後真的架了 HTTPS 才改成 true。
COOKIE_SECURE=false

# 登入有效期限（秒）。access 15 分鐘、refresh 14 天，通常不必改。
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=1209600
UPLOAD_URL_TTL=300
DOWNLOAD_URL_TTL=300
