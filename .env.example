# ---------- 資料庫 ----------
# 開發預設：PGlite 嵌入式 Postgres，無需安裝任何東西，資料放在 apps/api/.data
DB_DRIVER=pglite
PGLITE_DATA_DIR=./.data/pg
# 正式環境改成：
# DB_DRIVER=pg
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/work_student

# ---------- 檔案儲存 ----------
# 開發預設：本機磁碟 + 自簽 token 模擬 presigned URL
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./.storage
# 正式環境（Cloudflare R2 / MinIO / S3）改成：
# STORAGE_DRIVER=s3
# S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=work-student
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ---------- 服務 ----------
# 若 3000 被佔用（VSCode Live Preview 會同時吃掉 3000 與 3001），改成 3100 之類即可，
# 前端 proxy 與 API_PUBLIC_URL 都會自動跟著這個值走。API 啟動時會主動檢查並報錯。
PORT=3000
WEB_ORIGIN=http://localhost:5173
# API_PUBLIC_URL 不設就自動跟著 PORT 走；只有 API 對外網址與本機不同時才需要設定
# API_PUBLIC_URL=http://localhost:3000

# ---------- 安全 ----------
# 正式環境務必換掉：node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-only-secret-change-me-in-production-please
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=1209600
UPLOAD_URL_TTL=300
DOWNLOAD_URL_TTL=300
